<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{quotation.quotation_no}} - Quotation</title>
  <style>
    :root { --blue:#075ba7; --ink:#29333f; --muted:#667483; --line:#c9d3dc; --pale:#eaf3fa; }
    * { box-sizing:border-box; }
    html, body { margin:0; padding:0; background:#e9edf1; color:var(--ink); font-family:Arial,Helvetica,sans-serif; font-size:14px; line-height:1.45; }
    .page { position:relative; width:210mm; height:297mm; margin:8px auto; padding:13mm 15mm 24mm; overflow:hidden; background:#fff; box-shadow:0 1px 7px rgba(0,0,0,.15); }
    .header { display:flex; justify-content:space-between; align-items:flex-start; min-height:24mm; padding:0 3mm 6mm; border-bottom:1.2mm solid var(--blue); }
    .brand-logo { width:39mm; height:19mm; object-fit:contain; object-position:left top; }
    .brand-fallback { color:var(--blue); font-size:24px; font-weight:800; }
    .brand-fallback small { display:block; font-size:10px; font-weight:600; text-align:center; }
    .doc-head { text-align:right; }
    .doc-head h1 { margin:0; font-size:29px; line-height:1.05; letter-spacing:1px; color:#202b36; }
    .doc-number { margin:4px 0 0; color:var(--blue); font-size:14px; font-weight:800; }
    .doc-date { margin:2px 0 0; color:var(--muted); font-size:12px; }
    .party-meta { display:grid; grid-template-columns:1.15fr .38fr .48fr; gap:8mm; padding:8mm 0 6mm; border-bottom:1px solid var(--line); }
    .meta-label { margin:0 0 2px; color:var(--muted); font-size:12px; font-weight:700; }
    .party-name { margin:0; font-size:17px; font-weight:800; }
    .party-contact { margin:2px 0 0; color:var(--muted); }
    .meta-value { margin:0; font-size:15px; font-weight:800; white-space:nowrap; }
    .meta-value.blue { color:var(--blue); }
    .intro { margin:7mm 0 4mm; }
    .intro strong { display:block; margin-bottom:3mm; font-size:15px; }
    .intro p { margin:0; font-size:14px; }
    .section { margin-top:4mm; }
    .section-title { margin:0 0 3mm; color:var(--blue); font-size:17px; line-height:1.2; font-weight:800; text-transform:uppercase; }
    .section-title:after { content:""; display:block; width:18mm; margin-top:1.5mm; border-bottom:.55mm solid var(--blue); }
    .rich-text { font-size:13px; line-height:1.42; }
    .rich-text p { margin:2px 0; }
    .rich-text ul, .rich-text ol { margin:1.5mm 0; padding-left:6mm; }
    .rich-text li { margin:.5mm 0; padding-left:1mm; }
    .rich-text li::marker { color:var(--blue); }
    .items { width:100%; border-collapse:collapse; table-layout:fixed; font-size:12.5px; }
    .items th { padding:3.1mm 2.5mm; background:var(--pale); text-align:left; font-size:12px; }
    .items td { padding:3.2mm 2.5mm; border-bottom:1px solid var(--line); vertical-align:top; }
    .items .number { width:7%; text-align:center; }
    .items .description { width:49%; }
    .items .rate { width:16%; text-align:right; white-space:nowrap; }
    .items .discount, .items .gst { width:8%; text-align:center; white-space:nowrap; }
    .items .total { width:14%; text-align:right; white-space:nowrap; }
    .product-name { display:block; font-weight:800; }
    .product-description { display:block; margin-top:1mm; color:var(--muted); font-size:11.5px; }
    .items .total strong { color:var(--blue); }
    .terms-block { margin-top:8mm; }
    .terms-grid { width:100%; border-collapse:collapse; font-size:13px; }
    .terms-grid th, .terms-grid td { padding:3mm 0; border-bottom:1px solid var(--line); vertical-align:top; }
    .terms-grid th { width:40mm; text-align:left; font-weight:800; }
    .terms-rich { padding:0 !important; border:0 !important; }
    .bank-grid { width:105mm; border-collapse:collapse; font-size:13px; }
    .bank-grid td { padding:2.7mm 0; border-bottom:1px solid var(--line); }
    .bank-grid td:first-child { width:43mm; color:var(--muted); }
    .bank-grid td:last-child { font-weight:800; }
    .closing { display:grid; grid-template-columns:1fr 1fr; gap:20mm; margin-top:15mm; align-items:start; }
    .thanks { margin:0; font-size:14px; }
    .signature { text-align:center; font-weight:800; }
    .signature-company { display:block; margin-bottom:6mm; font-size:14px; }
    .signature img { display:block; width:38mm; height:24mm; margin:0 auto 2mm; object-fit:contain; }
    .signature-space { display:block; height:24mm; }
    .footer { position:absolute; right:15mm; bottom:7mm; left:15mm; display:grid; grid-template-columns:27mm 1fr 12mm; gap:4mm; align-items:end; min-height:15mm; padding-top:3mm; border-top:1px solid var(--line); }
    .footer-logo { width:24mm; height:12mm; object-fit:contain; object-position:left center; }
    .footer-company { color:var(--blue); font-weight:800; font-size:11px; }
    .footer-copy { color:var(--muted); font-size:9.5px; line-height:1.45; }
    .footer-partner-logos { display:flex; flex-wrap:wrap; align-items:center; gap:2mm; margin-top:1.5mm; }
    .footer-partner-logos img { width:auto; max-width:18mm; height:5.5mm; object-fit:contain; object-position:left center; }
    .page-number { color:var(--blue); font-size:10px; font-weight:800; text-align:right; }
    @page { size:A4; margin:0; }
    @media print {
      html,body { background:#fff; }
      .page { margin:0; box-shadow:none; break-after:page; page-break-after:always; }
      .page:last-child { break-after:auto; page-break-after:auto; }
    }
  </style>
</head>
<body>
  <section class="page">
    <header class="header">
      <div>
        {{#if company.logo_url}}<img class="brand-logo" src="{{company.logo_url}}" alt="{{company.name}}">
        {{else}}<div class="brand-fallback">{{company.name}}<small>{{company.tagline}}</small></div>{{/if}}
      </div>
      <div class="doc-head">
        <h1>QUOTATION</h1>
        <p class="doc-number">{{quotation.quotation_no}}</p>
        <p class="doc-date">{{quotation.quotation_date}}</p>
      </div>
    </header>

    <section class="party-meta">
      <div>
        <p class="meta-label">To,</p>
        <p class="party-name">{{customer.company_name}}</p>
        {{#if customer.contact_person}}<p class="party-contact">{{customer.contact_person}}</p>{{/if}}
      </div>
      <div>
        <p class="meta-label">Quotation Date</p>
        <p class="meta-value">{{quotation.quotation_date}}</p>
      </div>
      <div>
        <p class="meta-label">Quotation No.</p>
        <p class="meta-value blue">{{quotation.quotation_no}}</p>
      </div>
    </section>

    <section class="intro">
      <strong>Dear Sir/Madam,</strong>
      <p>We thank you very much for your enquiry for Tally Software Services and are pleased to quote our best offer same as follows.</p>
    </section>

    {{#if quotation.scope_of_work}}
    <section class="section">
      <h2 class="section-title">Scope of Work</h2>
      <div class="rich-text">{{{quotation.scope_of_work}}}</div>
    </section>
    {{/if}}

    <section class="section">
      <h2 class="section-title">Item Details</h2>
      <table class="items">
        <thead><tr><th class="number">Sr. No.</th><th class="description">Item Description</th><th class="rate">Rate</th><th class="discount">Disc</th><th class="gst">GST</th><th class="total">Total</th></tr></thead>
        <tbody>
          {{#each items}}
          <tr>
            <td class="number"><strong>{{display_index}}.</strong></td>
            <td class="description"><span class="product-name">{{product_name}}</span>{{#if product_description}}<span class="product-description">{{product_description}}</span>{{/if}}</td>
            <td class="rate"><strong>{{rate_formatted}}</strong></td>
            <td class="discount">{{#if discount_rate}}{{discount_rate}}%{{else}}-{{/if}}</td>
            <td class="gst">{{gst_rate_formatted}}</td>
            <td class="total"><strong>{{line_total_formatted}}</strong></td>
          </tr>
          {{else}}<tr><td colspan="6">No quotation items</td></tr>{{/each}}
        </tbody>
      </table>
    </section>

    {{#if quotation.notes}}
    <section class="section">
      <h2 class="section-title">Notes</h2>
      <div class="rich-text">{{{quotation.notes}}}</div>
    </section>
    {{/if}}

    <footer class="footer">
      <div>{{#if company.logo_url}}<img class="footer-logo" src="{{company.logo_url}}" alt="{{company.name}}">{{/if}}</div>
      <div><div class="footer-company">{{company.legal_name}}</div><div class="footer-copy">{{company.address}}<br>{{#if company.phone}}Contact: {{company.phone}}{{/if}}{{#if company.email}} &nbsp; | &nbsp; E Mail: {{company.email}}{{/if}}</div>{{#if footer_logos.length}}<div class="footer-partner-logos">{{#each footer_logos}}<img src="{{url}}" alt="{{name}}">{{/each}}</div>{{/if}}</div>
      <div class="page-number">1 / 2</div>
    </footer>
  </section>

  <section class="page">
    <header class="header">
      <div>
        {{#if company.logo_url}}<img class="brand-logo" src="{{company.logo_url}}" alt="{{company.name}}">
        {{else}}<div class="brand-fallback">{{company.name}}<small>{{company.tagline}}</small></div>{{/if}}
      </div>
      <div class="doc-head">
        <h1>QUOTATION</h1>
        <p class="doc-number">{{quotation.quotation_no}}</p>
        <p class="doc-date">{{quotation.quotation_date}}</p>
      </div>
    </header>

    <section class="terms-block">
      <h2 class="section-title">Terms &amp; Conditions</h2>
      {{#if company.quotation_terms_html}}
      <div class="rich-text">{{{company.quotation_terms_html}}}</div>
      {{else}}
      <table class="terms-grid">
        <tr><th>Delivery</th><td>Immediate</td></tr>
        <tr><th>Payment</th><td>100% Advance along with your confirmed order.</td></tr>
        <tr><th>Taxes</th><td>GST</td></tr>
        <tr><th>Extra Support</th><td>Support as per agreed scope of work.</td></tr>
      </table>
      {{/if}}
    </section>

    {{#if company.has_bank_details}}
    <section class="section" style="margin-top:9mm">
      <h2 class="section-title">Bank Details</h2>
      <table class="bank-grid">
        {{#if company.bank_name}}<tr><td>Bank Name</td><td>{{company.bank_name}}</td></tr>{{/if}}
        {{#if company.account_number}}<tr><td>A/C No.</td><td>{{company.account_number}}</td></tr>{{/if}}
        {{#if company.ifsc_code}}<tr><td>IFSC Code</td><td>{{company.ifsc_code}}</td></tr>{{/if}}
        {{#if company.branch}}<tr><td>Branch</td><td>{{company.branch}}</td></tr>{{/if}}
      </table>
    </section>
    {{/if}}

    <section class="closing">
      <p class="thanks">Thanking you</p>
      <div class="signature">
        <span class="signature-company">For {{company.legal_name}}</span>
        {{#if company.signature_url}}<img src="{{company.signature_url}}" alt="Authorized signature">{{else}}<span class="signature-space"></span>{{/if}}
        <span>Authorized Signatory</span>
      </div>
    </section>

    <footer class="footer">
      <div>{{#if company.logo_url}}<img class="footer-logo" src="{{company.logo_url}}" alt="{{company.name}}">{{/if}}</div>
      <div><div class="footer-company">{{company.legal_name}}</div><div class="footer-copy">{{company.address}}<br>{{#if company.phone}}Contact: {{company.phone}}{{/if}}{{#if company.email}} &nbsp; | &nbsp; E Mail: {{company.email}}{{/if}}</div>{{#if footer_logos.length}}<div class="footer-partner-logos">{{#each footer_logos}}<img src="{{url}}" alt="{{name}}">{{/each}}</div>{{/if}}</div>
      <div class="page-number">2 / 2</div>
    </footer>
  </section>
</body>
</html>
