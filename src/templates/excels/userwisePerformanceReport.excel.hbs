<tr>
    <td class="top-title" colspan="{{spreadsheetColumnCount}}">
        {{reportTitle}}
    </td>
</tr>

{{{spacerRow}}}

{{{summarySection}}}
<tr>
    <td colspan="{{spreadsheetColumnCount}}">&nbsp;</td>
</tr>
<tr>
    <td class="top-title" colspan="{{spreadsheetColumnCount}}">
        Ticket Count Breakdown
    </td>
</tr>
<tr>
    <td colspan="{{spreadsheetColumnCount}}">&nbsp;</td>
</tr>

<tr>
    <th class="ticket-header-cell">Sr No</th>
    <th class="ticket-header-cell">User</th>
    <th class="ticket-header-cell">Total</th>
    <th class="ticket-header-cell">Generated</th>
    <th class="ticket-header-cell">Open</th>
    <th class="ticket-header-cell">Pending</th>
    <th class="ticket-header-cell">Delegated</th>
    <th class="ticket-header-cell">In Progress</th>
    <th class="ticket-header-cell">Closed</th>
    <th class="ticket-header-cell">Overdue</th>
    <th class="ticket-header-cell">Productivity Score</th>
    <th class="ticket-header-cell">Last Ticket</th>
</tr>

{{#if hasUserRows}}

{{#each userRows}}

<tr style="height:40px;">

    <td class="ticket-cell" style="text-align: left;">
        {{srNo}}
    </td>

    <td class="ticket-cell" style="text-align: left;">
        {{user_name}}
    </td>

    <td class="ticket-cell" style="text-align: center;">
        {{total_tickets}}
    </td>

    <td class="ticket-cell" style="text-align: center;">
        {{generated}}
    </td>

    <td class="ticket-cell" style="text-align: center;">
        {{open_tickets}}
    </td>

    <td class="ticket-cell" style="text-align: center;">
        {{pending}}
    </td>

    <td class="ticket-cell" style="text-align: center;">
        {{delegated}}
    </td>

    <td class="ticket-cell" style="text-align: center;">
        {{in_progress_tickets}}
    </td>

    <td class="ticket-cell" style="text-align: center;">
        {{closed_tickets}}
    </td>

    <td class="ticket-cell" style="text-align: center;">
        {{overdue_tickets}}
    </td>

    <td class="ticket-cell" style="text-align: center;">
        {{productivity_score}}
    </td>

    <td class="ticket-cell" style="text-align: left;">
        <p>
            {{#if (eq last_ticket_no "-")}}
                -
            {{else}}
                {{last_ticket_no}}<br>
                {{last_ticket_status}} | {{last_ticket_date}}
            {{/if}}
        </p>
    </td>

</tr>

{{/each}}

{{else}}

<tr>
    <td
        class="empty-ticket-cell"
        colspan="{{spreadsheetColumnCount}}"
    >
        No users found for this period.
    </td>
</tr>

{{/if}}