<tr>
  <td class="section-title-cell" colspan="{{sectionColspan}}">
    {{leftTitle}}
  </td>

  {{{gapCells}}}

  <td class="section-title-cell" colspan="{{sectionColspan}}">
    {{rightTitle}}
  </td>
</tr>

{{#each rows}}
  <tr>
    <td class="detail-label-cell" colspan="{{../labelColspan}}">
      {{leftLabel}}
    </td>

    <td class="detail-value-cell" colspan="{{../valueColspan}}">
      {{leftValue}}
    </td>

    {{{../gapCells}}}

    <td class="detail-label-cell" colspan="{{../labelColspan}}">
      {{rightLabel}}
    </td>

    <td class="detail-value-cell" colspan="{{../valueColspan}}">
      {{rightValue}}
    </td>
  </tr>
{{/each}}
