<div style="background:#f4f7fb;padding:30px 15px;font-family:Arial,Helvetica,sans-serif;">
  <div style="max-width:700px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 8px 25px rgba(0,0,0,0.08);">
    <div style="background:#003b7d;padding:30px;text-align:center;">
      <h2 style="margin:0;color:#ffffff;font-size:28px;font-weight:700;">Quotation</h2>
      <p style="margin:10px 0 0;color:#dbeafe;font-size:15px;">{{quotationNo}}</p>
    </div>

    <div style="padding:30px;color:#172033;">
      <p style="margin:0 0 20px;font-size:16px;">Dear {{recipientName}},</p>

      <p style="margin:0 0 20px;line-height:1.7;color:#475569;">
        Thank you for your interest in our products and services. Please find your quotation attached to this email as a PDF document.
      </p>

      <div style="background:#f8fafc;border-left:5px solid #003b7d;padding:5px;border-radius:10px;margin:20px 0;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
          <tr>
            <td style="width:42%;padding:12px;border:1px solid #e8eef6;background:#f8fbff;color:#64748b;font-weight:600;">Quotation No.</td>
            <td style="padding:12px;border:1px solid #e8eef6;color:#003b7d;font-weight:700;">{{quotationNo}}</td>
          </tr>
          <tr>
            <td style="padding:12px;border:1px solid #e8eef6;background:#f8fbff;color:#64748b;font-weight:600;">Valid Until</td>
            <td style="padding:12px;border:1px solid #e8eef6;">{{validUntil}}</td>
          </tr>
          <tr>
            <td style="padding:12px;border:1px solid #e8eef6;background:#f8fbff;color:#64748b;font-weight:600;">Grand Total</td>
            <td style="padding:12px;border:1px solid #e8eef6;color:#003b7d;font-size:17px;font-weight:700;">{{grandTotal}}</td>
          </tr>
        </table>
      </div>

      <div style="background:#eff6ff;padding:16px;border:1px solid #bfdbfe;border-radius:10px;">
        <strong style="color:#003b7d;">PDF Attached</strong>
        <p style="margin:8px 0 0;color:#475569;line-height:1.6;">
          The detailed quotation, including products, pricing, GST and terms, is available in the attached PDF.
        </p>
      </div>

      <p style="margin:22px 0 0;line-height:1.7;color:#475569;">
        If you have any questions or require changes, please reply to this email. We will be happy to assist you.
      </p>

      <p style="margin:30px 0 0;color:#172033;">
        Regards,<br>
        <strong>{{companyName}}</strong>
      </p>
    </div>

    <div style="background:#f8fafc;padding:18px;text-align:center;border-top:1px solid #e2e8f0;">
      <p style="margin:0;font-size:13px;color:#64748b;">Thank you for choosing our services.</p>
    </div>
  </div>
</div>
